  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when Assistant runs on plain http://localhost). Requests that change something must come from the Assistant origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings → API tokens (`oa_assistant_...`): one role, always an expiry (ADR 0003). It has conversations and connected products of its own."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when Assistant is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "conflict",
              "not-found",
              "not-configured",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "assistant"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "logs"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://logs.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Model": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "configured"
            ],
            "properties": {
              "configured": {
                "const": false
              }
            },
            "description": "No model is set up: questions are refused and nothing is sent anywhere (ADR 0015)."
          },
          {
            "type": "object",
            "required": [
              "configured",
              "provider",
              "baseUrl",
              "model",
              "maxTokens",
              "hasKey",
              "destination",
              "updatedBy",
              "updatedAt"
            ],
            "properties": {
              "configured": {
                "const": true
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic"
                ],
                "description": "openai is any server with OpenAI's chat completions and tool calling: Ollama, vLLM, llama.cpp."
              },
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Where questions and what the tools return are sent."
              },
              "model": {
                "type": "string"
              },
              "maxTokens": {
                "type": "integer"
              },
              "hasKey": {
                "type": "boolean",
                "description": "Whether an API key is kept, sealed. It is never returned (ADR 0021)."
              },
              "destination": {
                "type": "object",
                "required": [
                  "host",
                  "network"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "network": {
                    "type": "string",
                    "enum": [
                      "this-host",
                      "private",
                      "internet"
                    ],
                    "description": "Where the address is, as far as its name tells: on this host, on a private network, or on the internet."
                  }
                }
              },
              "updatedBy": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "NewModel": {
        "type": "object",
        "required": [
          "provider",
          "baseUrl",
          "model"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "openai: up to and with /v1, such as http://ollama:11434/v1. anthropic: https://api.anthropic.com."
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "examples": [
              "llama3.1:8b"
            ]
          },
          "apiKey": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "description": "Sealed with the install's key. Leave it out to keep the one kept, which is only kept while baseUrl and provider stay; null removes it."
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 256,
            "maximum": 32000,
            "default": 2048,
            "description": "The longest answer, in the model's tokens."
          }
        }
      },
      "ModelCheck": {
        "type": "object",
        "required": [
          "ok",
          "ms",
          "reply",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "ms": {
            "type": "integer"
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "retentionDays"
        ],
        "properties": {
          "retentionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400,
            "description": "Conversations not added to for this long are deleted."
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tools",
          "allowed",
          "apiUrl",
          "webUrl",
          "connection"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The read-only tools that read this product."
          },
          "allowed": {
            "type": "boolean",
            "description": "Whether the tools may read it. Nothing is read until an admin allows it."
          },
          "apiUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where Assistant reads its API; from OPENASY_PRODUCTS until an admin sets another."
          },
          "webUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where people open it; citations link there."
          },
          "connection": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "connectedAt",
                  "lastUsedAt"
                ],
                "properties": {
                  "connectedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "lastUsedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The caller's own token for it, which every tool call to it uses. The token is never returned."
          }
        }
      },
      "SourceList": {
        "type": "object",
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "NewSource": {
        "type": "object",
        "required": [
          "allowed"
        ],
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "apiUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Needed to allow it. A new address drops every token connected for the old one."
          },
          "webUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "NewConnection": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "An API token of that product with the viewer or editor role, such as oa_logs_... It must be accepted there and must not be able to manage the product."
          }
        }
      },
      "Call": {
        "type": "object",
        "required": [
          "n",
          "tool",
          "source",
          "args",
          "status",
          "title",
          "detail",
          "href",
          "count",
          "ms",
          "error"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "description": "The number the answer cites it by, as [n]."
          },
          "tool": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "args": {
            "type": "object",
            "description": "The arguments, as checked."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "not-connected",
              "invalid",
              "error"
            ],
            "description": "ok read something; empty read nothing; not-connected: the caller has no token for the product; invalid: refused before anything was sent."
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "href": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The product's page with the same query, where the caller sees the data."
          },
          "count": {
            "type": "integer"
          },
          "ms": {
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "text",
          "status",
          "error",
          "createdAt"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "description": "An answer cites calls as [n]; citations of calls that read nothing are taken out."
          },
          "status": {
            "type": "string",
            "enum": [
              "question",
              "answered",
              "failed"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Call"
            },
            "description": "Every tool call the answer made, in order."
          },
          "cited": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "grounded": {
            "type": "boolean",
            "description": "false when no call read anything: nothing in the answer comes from a source."
          }
        }
      },
      "Conversation": {
        "type": "object",
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "messages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        }
      },
      "ConversationSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "questions",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "integer"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Products the last answer read."
          }
        }
      },
      "ConversationList": {
        "type": "object",
        "required": [
          "retentionDays",
          "conversations"
        ],
        "properties": {
          "retentionDays": {
            "type": "integer"
          },
          "conversations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            }
          }
        }
      },
      "NewQuestion": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
