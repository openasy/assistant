{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy Assistant API",
    "version": "0.1.0",
    "summary": "Questions across products in plain language, answered with read-only tools as the person asking, with every source cited.",
    "description": "Every screen of Assistant uses this API, and so can your scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nA question is answered by the language model an admin set, which may only call read-only tools; each tool reads one OpenAsy product with the caller's own API token for it, so an answer holds nothing the caller could not open in that product (ADR 0073). Conversations and tokens belong to whoever made them: a signed-in person, or an API token of Assistant. Each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This Assistant"
    }
  ],
  "tags": [
    {
      "name": "Conversations",
      "description": "Questions and their cited answers; each person's own."
    },
    {
      "name": "Sources",
      "description": "The products the tools read, and each person's token for them."
    },
    {
      "name": "Model",
      "description": "The language model questions are sent to, and how long conversations are kept."
    },
    {
      "name": "Product",
      "description": "Version and health of this Assistant."
    }
  ],
  "paths": {
    "/api/v1/conversations": {
      "get": {
        "operationId": "listConversations",
        "tags": [
          "Conversations"
        ],
        "summary": "The caller's conversations",
        "description": "Needs the viewer role. Newest first, at most 500. Nobody else's are listed, an admin's request included.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "x-openasy-role": "viewer"
      },
      "post": {
        "operationId": "ask",
        "tags": [
          "Conversations"
        ],
        "summary": "Ask a question",
        "description": "Needs the viewer role. Starts a conversation and answers its first question. The answer may have failed (status failed, with the model's error); the question is kept either way. One question per caller at a time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewQuestion"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The conversation, with the answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "x-openasy-role": "viewer"
      }
    },
